<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>

        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
        <property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/jdbcnew</property>
        <property name="hibernate.connection.username">postgres</property>
        <property name="hibernate.connection.password">8005</property>
        <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>
        <property name="hibernate.hbm2ddl.auto">create</property><!-- create first drop table then create it every time you run the project, update will update the table and if you dont have a table then it will create it. -->
        <property name="hibernate.show_sql">true</property>

        <mapping class="com.kushagra.alien"/>
        <mapping class="com.kushagra.Laptop"/>

    </session-factory>
</hibernate-configuration>